PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/krisala_mvp
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:3000

# Gemini. Server-side only: the key must never reach the browser.
# Leave GEMINI_API_KEY empty to run the AI layer in deterministic-only mode (no narration).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Per-user Gemini calls allowed per minute.
AI_RATE_LIMIT_PER_MIN=10

# Colab connector. Leave COLAB_API_URL empty to use the built-in mock feed.
COLAB_API_URL=
COLAB_API_KEY=
# Shared secret for systems pushing data to POST /api/integrations/import/:type (header x-integration-key).
INTEGRATION_API_KEY=
